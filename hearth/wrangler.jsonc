{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scorsby-hearth",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "HEARTH", "class_name": "Hearth" }, { "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hearth"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }],
  // a small language model checks that messages are kind before anyone sees them
  "ai": { "binding": "AI" },
  // the mailing list: names and emails of people who asked for letters
  "d1_databases": [{ "binding": "LETTERS", "database_name": "scorsby-letters", "database_id": "9c43ffce-c22b-4d42-b622-f6a6a1a3fd07" }],
  // the worker also serves the whole site, so the world and its hearth can live at one address.
  // what is left out is listed in ../.assetsignore. /hearth matches no file, so it reaches the worker.
  "assets": { "directory": "..", "binding": "ASSETS" },
  "vars": {
    // pages allowed to connect. localhost is always allowed for development.
    "ALLOWED_ORIGINS": "https://scorsby.us,https://www.scorsby.us,https://samrobertsbaca.github.io"
  },
  "observability": { "enabled": true }
}
