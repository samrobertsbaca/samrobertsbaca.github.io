{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scorsby-chance-trigger",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // every hour, on the hour; the worker itself knows which hours matter (see src/index.js)
  "triggers": { "crons": ["0 * * * *"] },
  // GITHUB_TOKEN is a secret, set with: npx wrangler secret put GITHUB_TOKEN (never written here)
  "observability": { "enabled": true }
}
